# Copy to .env and change the values:  cp .env.example .env && nano .env

# Database password (any long random text). Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-long-random-password

# Signs login sessions. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-another-long-random-string

# First admin account (only used the very first time, when there are no users).
# Log in with it, then change the password from "My account".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Website port on the VPS
APP_PORT=1100

# PostgreSQL port on the VPS (only reachable from the VPS itself)
DB_PORT=5433

# Optional: OpenAI key for the AI analyst (can also be set later in Settings -> AI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Biggest file you can upload (MB) and how long a login lasts (hours)
MAX_UPLOAD_MB=1024
TOKEN_HOURS=12
